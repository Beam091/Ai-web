# Copy to `.dev.vars` for local development. Never commit real secrets.

# development | production
APP_ENV=development

# Secret invite code required by POST /api/auth/register.
# Must be exactly 8 characters; the server normalizes it to uppercase.
# Example: `openssl rand -hex 4 | tr 'a-f' 'A-F'`
SIGNUP_CODE=REPLACE8

# OpenAI (optional). Leave commented out until you have a real key;
# an empty/placeholder value would make the UI advertise an unusable provider.
# OPENAI_API_KEY=sk-replace-me
# Optional override, must stay on the allowlisted api.openai.com host.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (optional). Leave commented out until you have a real key.
# GEMINI_API_KEY=replace-me
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: comma separated extra model ids appended to the built-in allowlist.
# EXTRA_OPENAI_MODELS=gpt-4.1-nano
# EXTRA_GEMINI_MODELS=gemini-2.0-flash

# Provider used by the "default" model selector entry.
DEFAULT_PROVIDER=mock

# Rate limits (requests per window, minutes)
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MINUTES=5
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15

# Generation guardrails: abort upstream after 90s and stop at ~32k chars.
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_CHARS=32000

# Mock provider only: milliseconds between tokens (default 8, max 500).
# Useful for demoing streaming or testing the timeout guard.
# MOCK_DELAY_MS=8
